# Ghost Save Manager - Environment Variables

# Frontend
VITE_API_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=YOUR_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT

# Backend
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/ghost-save-manager
MONGODB_TEST_URI=mongodb://localhost:27017/ghost-save-manager-test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=your_jwt_secret_key_change_this
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_EXPIRY=7d

FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_PRIVATE_KEY=YOUR_KEY
FIREBASE_CLIENT_EMAIL=YOUR_EMAIL

# File Storage
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=json,xml,zip,txt,sav

# Encryption
ENCRYPTION_KEY=your_aes_256_key
ENCRYPTION_IV=your_initialization_vector

# Email (for 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Admin Account
ADMIN_USERNAME=Digital Ghost Pulse
ADMIN_EMAIL=tortimothygaming@gmail.com
ADMIN_PASSWORD_HASH=bcrypt_hashed_password

# AI Detection Service (Optional)
AI_DETECTION_API=https://api.example.com
AI_DETECTION_KEY=your_api_key

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_HOST=localhost
ANALYTICS_PORT=8125
